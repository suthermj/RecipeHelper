@using RecipeHelper.Models.Dinner
@model ShareMealPlanVM

@{
    ViewData["Title"] = "Meal Plan";

    var weekStart = Model.WeekStart;
    var weekEnd   = weekStart.AddDays(6);

    string WeekRange(DateTime s, DateTime e) =>
        s.Year == e.Year
            ? $"{s:d MMM} – {e:d MMM yyyy}"
            : $"{s:d MMM yyyy} – {e:d MMM yyyy}";

    string[] dayNames = { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    string DefaultImg = "https://recipestoragep.blob.core.windows.net/recipe-images/default-recipe-image.webp";

    var entriesByDay = Enumerable.Range(0, 7)
        .ToDictionary(d => d, d => Model.Plan.Entries.Where(e => e.DayOfWeek == d).ToList());
}

<div class="pt-2 pb-4">

    <div class="px-4 pb-3">
        <div class="rounded-2xl px-4 py-3 text-center"
             style="background: linear-gradient(135deg, rgba(255,59,48,0.12), rgba(255,149,0,0.10)); border: 0.5px solid rgba(255,59,48,0.14); box-shadow: 0 2px 8px rgba(255,59,48,0.08);">
            <p class="text-[13px] font-medium leading-tight" style="color: var(--ios-label-2);">What's for dinner</p>
            <p class="text-[16px] font-semibold leading-tight mt-0.5" style="color: var(--ios-label);">
                @WeekRange(weekStart, weekEnd)
            </p>
        </div>
    </div>

    <div class="space-y-2 px-4">
        @for (int d = 0; d < 7; d++)
        {
            var dayEntries = entriesByDay[d];
            var dayDate    = weekStart.AddDays(d);

            <div class="rounded-2xl overflow-hidden" style="background: var(--ios-surface); box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
                <div class="px-4 pt-3 pb-1 flex items-center justify-between">
                    <p class="text-[15px] font-bold" style="color: var(--ios-label);">@dayNames[d]</p>
                    <p class="text-[13px]" style="color: var(--ios-label-2);">@dayDate.ToString("MMM d")</p>
                </div>

                <div class="px-3 pb-3">
                    @if (dayEntries.Count == 0)
                    {
                        <p class="py-2 text-[14px]" style="color: var(--ios-label-3);">No dinner planned</p>
                    }
                    else
                    {
                        <div class="space-y-1">
                            @foreach (var entry in dayEntries)
                            {
                                <div class="flex items-center gap-3 py-1.5">
                                    <div class="w-14 h-10 rounded-lg overflow-hidden shrink-0" style="background: var(--ios-fill);">
                                        <img src="@(entry.Recipe?.ThumbnailUri is { Length: > 0 } tu ? tu : entry.Recipe?.ImageUri is { Length: > 0 } u ? u : DefaultImg)"
                                             alt="" loading="lazy" decoding="async" class="w-full h-full object-cover" />
                                    </div>
                                    <p class="flex-1 text-[14px] font-medium truncate" style="color: var(--ios-label);">
                                        @(entry.Recipe?.Name ?? "")
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

</div>
