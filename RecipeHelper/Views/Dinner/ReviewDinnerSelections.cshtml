@using RecipeHelper.Models.Kroger
@using RecipeHelper.Models.Dinner
@model ReviewDinnerSelectionsVM

@{
    ViewData["Title"]     = "Ingredients";
    ViewData["NavTitle"]  = "Ingredients";
    ViewData["BackLink"]  = Url.Action("Index", "Dinner");
    ViewData["BackLabel"] = "Meal Plan";

    var sectionOrder = new[] { "Produce", "Meat", "Dairy", "Pantry", "Bakery", "Frozen" };

    // Real Apple system colors, loosely mapped to each department's actual substance
    // (green=fresh produce, pink=meat, blue=dairy, brown=dry goods, orange=baked goods,
    // teal=frozen/cold) rather than invented hues -- keeps the page feeling native to
    // the app's existing iOS palette instead of importing a new one. Deliberately only
    // covers the known grocery categories: "Other" and anything else (including
    // recipe-internal headings that leak into this field on some imported recipes --
    // see PR notes) fall through to a neutral gray dot rather than being colored as if
    // they were a real department, which would make that data gap harder to notice.
    var sectionColors = new Dictionary<string, string>
    {
        ["Produce"] = "#34C759",
        ["Meat"]    = "#FF2D55",
        ["Dairy"]   = "#007AFF",
        ["Pantry"]  = "#A2845E",
        ["Bakery"]  = "#FF9500",
        ["Frozen"]  = "#5AC8FA",
    };

    var grouped = Model.Ingredients
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Section) ? "Other" : i.Section.Trim())
        .OrderBy(g => {
            var idx = Array.IndexOf(sectionOrder, g.Key);
            return idx >= 0 ? idx : (g.Key == "Other" ? 999 : 100);
        })
        .ThenBy(g => g.Key)
        .ToList();

    // Keys that appear in more than one recipe group -- flagged in the by-recipe view
    // so it's clear an ingredient's amount there is only that recipe's share, not the
    // full shopping total (which still lives in the section view / merged Ingredients).
    var sharedKeys = Model.RecipeGroups
        .SelectMany(g => g.Ingredients.Select(i => i.DimensionKey).Distinct())
        .GroupBy(k => k)
        .Where(g => g.Count() > 1)
        .Select(g => g.Key)
        .ToHashSet();

    // Shared row template for both views (#78) -- display only, no form inputs. Every
    // row is tagged data-key (IngredientVM.DimensionKey: name + dimension family) so
    // toggling any row with a given key, in either view, can find and update every
    // other row sharing it plus the one canonical hidden input block that actually
    // submits (see #ingredient-inputs below).
    Func<(IngredientVM Item, bool IsRecipeView), object> RenderRow = @<div class="ingredient-row ios-cell cursor-pointer select-none transition-opacity"
         data-key="@item.Item.DimensionKey"
         data-name="@item.Item.Name.ToLowerInvariant()"
         style="border-bottom: 0.5px solid var(--ios-separator);">
        <!-- Check circle -->
        <div class="check-circle h-6 w-6 rounded-full shrink-0 flex items-center justify-center transition-colors"
             style="background: #34C759; border: 2px solid #34C759;">
            <svg class="check-icon h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>
        <span class="item-name flex-1 text-[15px] font-medium" style="color: var(--ios-label);">
            @item.Item.Name
            @if (item.IsRecipeView && sharedKeys.Contains(item.Item.DimensionKey))
            {
                <span class="text-[11px] font-normal" style="color: var(--ios-label-2);">(shared)</span>
            }
        </span>
        <span class="text-[12px] font-medium shrink-0 px-2 py-0.5 rounded-full" style="color: var(--ios-label-2); background: var(--ios-fill);">
            @item.Item.DisplayQuantity @item.Item.DisplayMeasurement
        </span>
    </div>;
}

<div class="pt-2 pb-36">

    @if (Model.Ingredients == null || !Model.Ingredients.Any())
    {
        <div class="px-4 py-14 text-center">
            <p class="text-[15px]" style="color: var(--ios-label-2);">
                No ingredients to display. Make sure you've selected at least one recipe.
            </p>
        </div>
    }
    else
    {
        <form asp-controller="Cart"
              asp-action="PreviewAddToCart"
              method="post"
              id="add-to-kroger-form"
              class="loading-form"
              data-loading-text="Building Kroger cart items…">
            @Html.AntiForgeryToken()

            <!-- Progress -- the page's actual job (get from unsorted ingredients to a
                 confirmed list) made visible as it happens, updated live by JS
                 (updateCounts below) from the same canonical checkbox state that drives
                 submission -- purely a read-out, no effect on what's submitted. -->
            <div class="px-4 pb-3">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[13px] font-semibold" style="color: var(--ios-label);">Shopping progress</span>
                    <span id="progressLabel" class="text-[13px]" style="color: var(--ios-label-2);">@Model.Ingredients.Count of @Model.Ingredients.Count checked</span>
                </div>
                <div class="ios-progress-track">
                    <div id="progressFill" class="ios-progress-fill" style="width: 100%;"></div>
                </div>
            </div>

            <!-- Search + view toggle + bulk actions -->
            <div class="px-4 pb-3 space-y-2.5">
                <div class="flex items-center gap-2">
                    <div class="ios-search-wrap flex-1">
                        <svg class="ios-search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                        </svg>
                        <input type="text" id="ingredientSearch" placeholder="Search ingredients…"
                               class="ios-search-input" />
                    </div>
                    <div class="ios-segmented shrink-0">
                        <button type="button" id="viewBySectionBtn" class="view-toggle-btn ios-segmented-btn active" data-view="section">Section</button>
                        <button type="button" id="viewByRecipeBtn"  class="view-toggle-btn ios-segmented-btn" data-view="recipe">Recipe</button>
                    </div>
                </div>
                <div class="flex overflow-x-auto gap-2 hide-scrollbar">
                    <button type="button" id="selectAllBtn" class="ios-pill">Select all</button>
                    <button type="button" id="clearAllBtn"  class="ios-pill">Clear all</button>
                    <button type="button" id="pantryBtn"    class="ios-pill">Uncheck pantry</button>
                </div>
            </div>

            <!-- Canonical form inputs -- the only thing that submits. One block per
                 merged ingredient row, in the same section-grouped order/index sequence
                 as before this change, so Items[i] indices are unchanged regardless of
                 which display view is active. -->
            <div id="ingredient-inputs" hidden>
                @{var i = 0;}
                @foreach (var group in grouped)
                {
                    foreach (var item in group)
                    {
                        <div class="ing-inputs" data-key="@item.DimensionKey">
                            <input type="checkbox"
                                   name="Items[@i].Include"
                                   value="true"
                                   checked
                                   class="ingredient-checkbox" />
                            <input type="hidden" name="Items[@i].Name"        value="@item.Name" />
                            <input type="hidden" name="Items[@i].Upc"         value="@item.Upc" />
                            <input type="hidden" name="Items[@i].Quantity"    value="@item.Quantity" />
                            <input type="hidden" name="Items[@i].Modality"    value="PICKUP" />
                            <input type="hidden" name="Items[@i].Measurement" value="@item.Measurement" />
                        </div>
                        i++;
                    }
                }
            </div>

            <!-- Grouped by grocery section (default view) -->
            <div id="viewBySection" class="review-view">
                @foreach (var group in grouped)
                {
                    var dotColor = sectionColors.TryGetValue(group.Key, out var c) ? c : "var(--ios-label-3)";
                    <div class="section-group mb-5" data-section="@group.Key">
                        <div class="flex items-center justify-between px-4 pt-1 pb-1.5">
                            <div class="flex items-center gap-2">
                                <span class="h-2.5 w-2.5 rounded-full shrink-0" style="background: @dotColor;"></span>
                                <p class="ios-section-hdr" style="padding: 0;">@group.Key</p>
                            </div>
                            <span class="group-count text-[12px]" style="color: var(--ios-label-3);">@group.Count() of @group.Count()</span>
                        </div>
                        <div class="ios-group">
                            @foreach (var item in group)
                            {
                                @RenderRow((item, false))
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Grouped by recipe -->
            <div id="viewByRecipe" class="review-view hidden">
                @foreach (var recipeGroup in Model.RecipeGroups)
                {
                    <div class="section-group mb-5" data-section="@recipeGroup.RecipeName">
                        <div class="flex items-center gap-2.5 px-4 pt-1 pb-2">
                            <div class="h-9 w-9 rounded-lg overflow-hidden shrink-0" style="background: var(--ios-fill); box-shadow: 0 1px 4px rgba(0,0,0,0.07);">
                                <img src="@(recipeGroup.ThumbnailUri is { Length: > 0 } tu ? tu : recipeGroup.ImageUri)"
                                     alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
                            </div>
                            <p class="flex-1 text-[15px] font-semibold truncate" style="color: var(--ios-label);">
                                @recipeGroup.RecipeName
                                @if (recipeGroup.Occurrences > 1)
                                {
                                    <span class="text-[12px] font-medium" style="color: var(--ios-label-2);">×@recipeGroup.Occurrences</span>
                                }
                            </p>
                            <span class="group-count text-[12px] shrink-0" style="color: var(--ios-label-3);">@recipeGroup.Ingredients.Count of @recipeGroup.Ingredients.Count</span>
                        </div>
                        <div class="ios-group">
                            @foreach (var item in recipeGroup.Ingredients)
                            {
                                @RenderRow((item, true))
                            }
                        </div>
                    </div>
                }
            </div>
        </form>
    }
</div>

<!-- Sticky bottom action bar -->
@if (Model.Ingredients != null && Model.Ingredients.Any())
{
    <div class="fixed inset-x-0 z-30 px-4 py-3"
         style="bottom: calc(49px + env(safe-area-inset-bottom));
                background: rgba(249,249,249,0.94);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-top: 0.5px solid var(--ios-separator);">
        <div class="max-w-3xl mx-auto flex gap-3">
            <button type="button" id="add-to-list-button" class="btn-secondary flex-1">
                Shopping List
            </button>
            <button type="submit" form="add-to-kroger-form" id="add-to-kroger-button" class="btn-primary flex-1">
                Kroger Cart
            </button>
        </div>
    </div>
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var form    = document.getElementById('add-to-kroger-form');
        var listBtn = document.getElementById('add-to-list-button');

        // add-to-kroger-button is type="submit" (associated to #add-to-kroger-form via its
        // form="" attribute), so clicking it already submits natively -- no JS
        // needed. The shared loading overlay (site.js, driven by the form's
        // "loading-form" class) covers the whole screen once shown, which is
        // enough to block a repeat tap; a separate button-text swap would just
        // be a second, redundant loading indicator underneath it.
        listBtn?.addEventListener('click', function () {
            form.action = '@Url.Action("CreateFromMealPlan", "ShoppingList")';
            form.requestSubmit();
        });

        function styleRow(row, checked) {
            var circle = row.querySelector('.check-circle');
            var icon   = row.querySelector('.check-icon');
            var name   = row.querySelector('.item-name');

            if (checked) {
                row.style.opacity = '';
                if (circle) {
                    circle.style.background = '#34C759';
                    circle.style.borderColor = '#34C759';
                    // Brief scale-pop on check only (not uncheck, so bulk clear-all
                    // doesn't fire it) -- stands in for haptic feedback, same idea as
                    // Dinner/Index's day-card-target-pop on a drag crossing into a new
                    // day. 'animationend' with once:true means rapid re-taps just
                    // restart cleanly rather than stacking listeners.
                    circle.classList.remove('pop');
                    void circle.offsetWidth; // force reflow so re-adding the class restarts the animation
                    circle.classList.add('pop');
                    circle.addEventListener('animationend', function () {
                        circle.classList.remove('pop');
                    }, { once: true });
                }
                if (icon)   icon.classList.remove('hidden');
                if (name)   { name.style.textDecoration = ''; name.style.color = ''; }
            } else {
                row.style.opacity = '0.4';
                if (circle) { circle.style.background = 'var(--ios-fill)'; circle.style.borderColor = 'var(--ios-separator)'; }
                if (icon)   icon.classList.add('hidden');
                if (name)   { name.style.textDecoration = 'line-through'; name.style.color = 'var(--ios-label-2)'; }
            }
        }

        var progressLabel = document.getElementById('progressLabel');
        var progressFill  = document.getElementById('progressFill');

        // Reads the same canonical checkbox state that drives submission -- purely a
        // read-out for the progress bar / per-group counts, no effect on what's
        // actually submitted. Called after every state-changing action.
        function updateCounts() {
            var allInputs = document.querySelectorAll('.ing-inputs');
            var total = allInputs.length;
            var checked = 0;
            allInputs.forEach(function (el) {
                if (el.querySelector('.ingredient-checkbox')?.checked) checked++;
            });
            if (progressLabel) progressLabel.textContent = checked + ' of ' + total + ' checked';
            if (progressFill) progressFill.style.width = (total ? Math.round(checked / total * 100) : 0) + '%';

            document.querySelectorAll('.section-group').forEach(function (group) {
                var rows = group.querySelectorAll('.ingredient-row');
                var groupChecked = 0;
                rows.forEach(function (row) {
                    var cb = document.querySelector('.ing-inputs[data-key="' + CSS.escape(row.dataset.key) + '"] .ingredient-checkbox');
                    if (cb?.checked) groupChecked++;
                });
                var countEl = group.querySelector('.group-count');
                if (countEl) countEl.textContent = groupChecked + ' of ' + rows.length;
            });
        }

        // Toggling a key updates every display row sharing it (in both views) plus the
        // one canonical hidden input block that actually submits.
        function setKeyState(key, checked) {
            document.querySelectorAll('.ingredient-row[data-key="' + CSS.escape(key) + '"]').forEach(function (row) {
                styleRow(row, checked);
            });
            var inputBlock = document.querySelector('.ing-inputs[data-key="' + CSS.escape(key) + '"]');
            var cb = inputBlock?.querySelector('.ingredient-checkbox');
            if (cb) cb.checked = checked;
            updateCounts();
        }

        function allKeys() {
            return Array.from(document.querySelectorAll('.ing-inputs')).map(function (el) { return el.dataset.key; });
        }

        document.addEventListener('click', function (e) {
            var row = e.target.closest('.ingredient-row');
            if (!row) return;
            var key = row.dataset.key;
            var cb = document.querySelector('.ing-inputs[data-key="' + CSS.escape(key) + '"] .ingredient-checkbox');
            setKeyState(key, !cb?.checked);
        });

        var searchInput = document.getElementById('ingredientSearch');
        function applySearch() {
            var term = (searchInput?.value || '').toLowerCase().trim();
            var activeView = document.querySelector('.review-view:not(.hidden)');
            if (!activeView) return;
            activeView.querySelectorAll('.section-group').forEach(function (group) {
                var visibleCount = 0;
                group.querySelectorAll('.ingredient-row').forEach(function (row) {
                    var matches = !term || row.dataset.name.includes(term);
                    row.classList.toggle('hidden', !matches);
                    if (matches) visibleCount++;
                });
                group.classList.toggle('hidden', visibleCount === 0);
            });
        }
        searchInput?.addEventListener('input', applySearch);

        var pantryKeywords = [
            'olive oil','vegetable oil','canola oil','cooking oil',
            'salt','pepper','black pepper',
            'garlic powder','onion powder','baking powder','baking soda',
            'brown sugar','sugar','flour','cornstarch',
            'vinegar','soy sauce','butter','water',
            'paprika','cumin','oregano','basil','thyme','cinnamon','oil'
        ];

        document.getElementById('selectAllBtn')?.addEventListener('click', function () {
            allKeys().forEach(function (key) { setKeyState(key, true); });
        });
        document.getElementById('clearAllBtn')?.addEventListener('click', function () {
            allKeys().forEach(function (key) { setKeyState(key, false); });
        });
        document.getElementById('pantryBtn')?.addEventListener('click', function () {
            allKeys().forEach(function (key) {
                var name = key.split('|')[0];
                if (pantryKeywords.some(function (kw) { return name.includes(kw); })) {
                    setKeyState(key, false);
                }
            });
        });

        // View toggle (Section / Recipe), persisted in localStorage.
        var viewToggleBtns = document.querySelectorAll('.view-toggle-btn');
        var views = {
            section: document.getElementById('viewBySection'),
            recipe:  document.getElementById('viewByRecipe')
        };
        function setView(view) {
            if (!views[view]) view = 'section';
            Object.keys(views).forEach(function (key) {
                views[key].classList.toggle('hidden', key !== view);
            });
            viewToggleBtns.forEach(function (btn) {
                btn.classList.toggle('active', btn.dataset.view === view);
            });
            localStorage.setItem('reviewIngredientsView', view);
            applySearch();
        }
        viewToggleBtns.forEach(function (btn) {
            btn.addEventListener('click', function () { setView(btn.dataset.view); });
        });
        setView(localStorage.getItem('reviewIngredientsView') || 'section');
        updateCounts();
    });
</script>
