@model RecipeHelper.Models.Kroger.KrogerProductDto
@{
    ViewData["Title"]    = "Product";
    ViewData["NavTitle"] = Model.name?.Length > 22 ? Model.name.Substring(0, 22) + "…" : Model.name;
    ViewData["BackLink"] = Url.Action("Products", "Product");
    ViewData["BackLabel"] = "Products";
    var productId = ViewBag.ProductId;
    var usedIn = (ViewBag.UsedInRecipes as List<RecipeHelper.Controllers.ProductRecipeUsage>) ?? new();
    var usedInRecipeCount = usedIn.Count;
    const string defaultRecipeImg = "https://recipestoragep.blob.core.windows.net/recipe-images/default-recipe-image.webp";
}

@section NavRight {
    <form asp-action="DeleteProduct" asp-controller="Product" method="post" id="deleteForm" class="inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="productId" value="@productId" />
        <button type="submit" class="ios-btn-text-destructive">Delete</button>
    </form>
}

<div class="pt-2 pb-6">

    @if (TempData["WarningMessage"] is string warn && !string.IsNullOrWhiteSpace(warn))
    {
        <div id="warningMessage" class="mx-4 mb-3 rounded-2xl px-4 py-3 text-[14px]"
             style="background: #FFFBE6; color: #7A5900; position: relative;">
            &#9888; @warn
            <button type="button" class="absolute top-2 right-3 text-lg"
                    onclick="document.getElementById('warningMessage').style.display='none';">&times;</button>
        </div>
    }

    <!-- Product image -->
    <div class="flex justify-center px-4 pb-4">
        <div class="rounded-2xl overflow-hidden" style="background: var(--ios-surface); box-shadow: 0 4px 16px rgba(0,0,0,0.08);">
            <img src="https://www.kroger.com/product/images/medium/front/@Model.upc"
                 alt="@Model.name"
                 class="h-52 w-52 object-contain p-3" />
        </div>
    </div>

    <!-- Name (inline edit) -->
    <div class="px-4 pb-3">
        <div class="flex items-center gap-2">
            <h1 id="productNameText" class="text-[22px] font-bold flex-1" style="color: var(--ios-label);">@Model.name</h1>
            <button id="editNameBtn" type="button" class="ios-btn-text-sm p-1.5 rounded-lg" style="background: var(--ios-fill);">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M17.414 2.586a2 2 0 00-2.828 0L6 11.172V14h2.828l8.586-8.586a2 2 0 000-2.828z" />
                    <path fill-rule="evenodd" d="M4 16h12a1 1 0 110 2H4a1 1 0 110-2z" clip-rule="evenodd" />
                </svg>
            </button>
        </div>
        <input id="productNameInput" type="text" value="@Model.name" class="hidden field-input w-full mt-2" />
        <div id="nameEditBtns" class="hidden flex gap-2 mt-2">
            <button id="saveNameBtn" type="button" class="btn-primary flex-1" style="padding-top: 8px; padding-bottom: 8px; font-size:14px;">Save</button>
            <button id="cancelNameBtn" type="button" class="btn-secondary flex-1" style="padding-top: 8px; padding-bottom: 8px; font-size:14px;">Cancel</button>
        </div>
        <div id="statusMsg" class="hidden mt-2 text-[13px]"></div>
    </div>

    <!-- Add to cart -->
    <div class="px-4 pb-4">
        @* Posts straight to BeginAddToCart (Kroger auth → add), skipping the preview
           screen: a saved product is already a specific UPC and the quantity is a pack
           count, so there's nothing to review or map. *@
        <form asp-action="BeginAddToCart" asp-controller="Cart" method="post"
              class="loading-form" data-loading-text="Adding to Kroger cart…">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Origin" value="@RecipeHelper.Models.Kroger.CartOrigin.Products" />
            <input type="hidden" name="ReturnProductId" value="@Model.upc" />
            <input type="hidden" name="Items[0].Upc" value="@Model.upc" />
            <input type="hidden" name="Items[0].Name" value="@Model.name" />
            <input type="hidden" name="Items[0].Include" value="true" />
            <div class="flex items-center gap-3">
                <div class="flex items-center rounded-xl overflow-hidden" style="background: var(--ios-fill);">
                    <button type="button" id="qtyMinus"
                            style="width:44px; height:44px; font-size:18px; color: var(--ios-label);">−</button>
                    <input type="number" id="qtyInput" name="Items[0].Quantity" value="1" min="1" step="1" inputmode="numeric" required
                           class="text-center" style="width:44px; height:44px; background:transparent; border:none; font-size:16px; color: var(--ios-label);" />
                    <button type="button" id="qtyPlus"
                            style="width:44px; height:44px; font-size:18px; color: var(--ios-label);">+</button>
                </div>
                <button type="submit" class="btn-primary flex-1">Add to Cart</button>
            </div>
        </form>
    </div>

    <!-- Details -->
    <p class="ios-section-hdr">Details</p>
    <div class="ios-group">
        <div class="ios-cell justify-between">
            <span class="text-[15px]" style="color: var(--ios-label-2);">Size</span>
            <span class="text-[15px] font-medium" style="color: var(--ios-label);">@(Model.size ?? "—")</span>
        </div>
        <div class="ios-cell justify-between">
            <span class="text-[15px]" style="color: var(--ios-label-2);">Sold By</span>
            <span class="text-[15px] font-medium" style="color: var(--ios-label);">@(Model.soldBy ?? "—")</span>
        </div>
        <div class="ios-cell justify-between">
            <span class="text-[15px]" style="color: var(--ios-label-2);">Stock</span>
            <span class="text-[15px] font-medium" style="color: var(--ios-label);">@(Model.stockLevel ?? "—")</span>
        </div>
        @if (Model.categories != null && Model.categories.Any())
        {
            <div class="ios-cell justify-between">
                <span class="text-[15px]" style="color: var(--ios-label-2);">Category</span>
                <span class="text-[13px] font-medium text-right" style="color: var(--ios-label); max-width: 60%;">@string.Join(", ", Model.categories)</span>
            </div>
        }
        <div class="ios-cell justify-between">
            <span class="text-[15px]" style="color: var(--ios-label-2);">Price</span>
            @{
                var regular = (decimal)Model.regularPrice;
                var sale = (decimal)Model.promoPrice;
                var isKrogerBrand = RecipeHelper.Utility.KrogerBrandDiscount.IsKrogerBrand(Model.brand);
                var estimated = RecipeHelper.Utility.KrogerBrandDiscount.EstimatedPrice(Model.brand, regular, sale);
            }
            @if (estimated < regular)
            {
                <div class="text-right">
                    <div>
                        <span class="text-[17px] font-bold" style="color: #34C759;">$@estimated.ToString("0.00")</span>
                        <span class="text-[13px] line-through ml-1" style="color: var(--ios-label-2);">$@regular.ToString("0.00")</span>
                    </div>
                    <div class="flex flex-wrap justify-end gap-1 mt-1">
                        @if (Model.onSale)
                        {
                            <span class="ios-badge" style="background: #FFF0F0; color: var(--ios-red);">Sale · Save $@((regular - sale).ToString("0.00"))</span>
                        }
                        @if (isKrogerBrand)
                        {
                            <span class="ios-badge" style="background: #E8F8ED; color: #1F9D55;">-10% Kroger brand</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <span class="text-[17px] font-bold" style="color: var(--ios-label);">$@regular.ToString("0.00")</span>
            }
        </div>
    </div>
    <!-- Recipes using this product -->
    <p class="ios-section-hdr">Recipes</p>
    <div class="ios-group">
        @if (usedIn.Count == 0)
        {
            <div class="ios-cell">
                <span class="text-[15px]" style="color: var(--ios-label-2);">Not used in any recipes</span>
            </div>
        }
        else
        {
            <details class="group">
                <summary class="ios-cell justify-between cursor-pointer" style="min-height: 44px;">
                    <span class="text-[15px] font-medium" style="color: var(--ios-label);">Used in @usedInRecipeCount @(usedInRecipeCount == 1 ? "recipe" : "recipes")</span>
                    <span class="text-[13px] group-open:hidden" style="color: var(--ios-label-2);">Show</span>
                    <span class="text-[13px] hidden group-open:inline" style="color: var(--ios-label-2);">Hide</span>
                </summary>
                @foreach (var u in usedIn)
                {
                    <a asp-controller="Recipe" asp-action="ViewRecipe" asp-route-Id="@u.RecipeId" asp-route-from="product" asp-route-productId="@productId"
                       class="ios-cell gap-3" style="min-height: 56px;">
                        <img src="@(string.IsNullOrWhiteSpace(u.ImageUrl) ? defaultRecipeImg : u.ImageUrl)" alt=""
                             class="h-10 w-10 rounded-lg object-cover flex-shrink-0" loading="lazy" />
                        <div class="min-w-0 flex-1 text-[15px] font-medium truncate" style="color: var(--ios-label);">@u.RecipeName</div>
                    </a>
                }
            </details>
            <button type="button" id="openReplace" class="ios-cell justify-between w-full text-left" style="min-height: 44px;">
                <span class="text-[15px] font-medium" style="color: var(--ios-red);">Replace product in recipes…</span>
            </button>
        }
    </div>
</div>

@if (usedIn.Count > 0)
{
    <!-- Replace-product sheet -->
    <div id="replaceModal" class="hidden fixed inset-0 z-[200]" style="background: rgba(0,0,0,0.4);">
        <div class="absolute inset-x-0 bottom-0 flex flex-col rounded-t-2xl"
             style="background: var(--ios-surface); max-height: 85vh; padding-bottom: env(safe-area-inset-bottom);">
            <div class="flex items-center justify-between px-4 py-3">
                <button type="button" id="replaceCancel" class="ios-btn-text-sm" style="min-height:44px;">Cancel</button>
                <span class="text-[17px] font-semibold" style="color: var(--ios-label);">Replace product</span>
                <span style="width:60px;"></span>
            </div>
            <div class="overflow-y-auto px-4 pb-3 flex-1">
                <p class="text-[13px] mb-2" style="color: var(--ios-label-2);">New product</p>
                <div id="replacePicked" class="hidden ios-group" style="margin:0 0 12px 0;">
                    <div class="ios-cell gap-3">
                        <img id="replacePickedImg" alt="" class="h-10 w-10 object-contain flex-shrink-0" />
                        <div id="replacePickedName" class="min-w-0 flex-1 text-[15px] font-medium" style="color: var(--ios-label);"></div>
                        <button type="button" id="replaceChange" class="ios-btn-text-sm">Change</button>
                    </div>
                </div>
                <div id="replaceSearchWrap">
                    <input id="replaceSearch" type="search" placeholder="Search products…" class="field-input w-full" autocomplete="off" />
                    <div id="replaceResults" class="ios-group" style="margin:8px 0 12px 0;"></div>
                </div>

                <div class="flex items-center justify-between mb-2 mt-2">
                    <p class="text-[13px]" style="color: var(--ios-label-2);">Recipes</p>
                    <button type="button" id="replaceToggleAll" class="ios-btn-text-sm">Deselect all</button>
                </div>
                <div class="ios-group" style="margin:0;">
                    @foreach (var u in usedIn)
                    {
                        <label class="ios-cell gap-3 cursor-pointer" style="min-height: 52px;">
                            <input type="checkbox" class="js-replace-recipe h-5 w-5 flex-shrink-0" value="@u.RecipeId" checked />
                            <img src="@(string.IsNullOrWhiteSpace(u.ImageUrl) ? defaultRecipeImg : u.ImageUrl)" alt=""
                                 class="h-8 w-8 rounded-lg object-cover flex-shrink-0" loading="lazy" />
                            <span class="min-w-0 flex-1 text-[15px] truncate" style="color: var(--ios-label);">@u.RecipeName</span>
                        </label>
                    }
                </div>
                <div id="replaceStatus" class="hidden mt-3 text-[13px]"></div>
            </div>
            <div class="px-4 pt-2 pb-3">
                <button type="button" id="replaceConfirm" class="btn-primary w-full" disabled style="opacity:.5;">Replace</button>
            </div>
        </div>
    </div>
}

<!-- hidden form for anti-forgery token -->
<form id="afForm" method="post" class="hidden">
    @Html.AntiForgeryToken()
</form>

<script>
    (function () {
        const nameText   = document.getElementById('productNameText');
        const nameInput  = document.getElementById('productNameInput');
        const editBtns   = document.getElementById('nameEditBtns');
        const btnEdit    = document.getElementById('editNameBtn');
        const btnSave    = document.getElementById('saveNameBtn');
        const btnCancel  = document.getElementById('cancelNameBtn');
        const statusMsg  = document.getElementById('statusMsg');

        const productId = @productId;
        const updateUrl = '@Url.Action("UpdateProduct", "Product")';
        const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;

        function setEditing(editing) {
            nameText.classList.toggle('hidden', editing);
            nameInput.classList.toggle('hidden', !editing);
            editBtns.classList.toggle('hidden', !editing);
            btnEdit.classList.toggle('hidden', editing);
            if (editing) {
                nameInput.value = nameText.textContent.trim();
                nameInput.focus();
                nameInput.select();
            }
        }

        function showStatus(text, ok) {
            statusMsg.textContent = text;
            statusMsg.classList.remove('hidden');
            statusMsg.style.color = ok ? '#34C759' : 'var(--ios-red)';
            setTimeout(() => { statusMsg.classList.add('hidden'); }, 3000);
        }

        btnEdit.addEventListener('click', () => setEditing(true));
        btnCancel.addEventListener('click', () => setEditing(false));

        nameInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); btnSave.click(); }
            if (e.key === 'Escape') { e.preventDefault(); btnCancel.click(); }
        });

        btnSave.addEventListener('click', async () => {
            const newName = nameInput.value.trim();
            if (!newName) { showStatus('Name cannot be empty.', false); return; }
            if (newName === nameText.textContent.trim()) { setEditing(false); return; }

            try {
                const body = new URLSearchParams({
                    productId: String(productId),
                    updatedProductName: newName,
                    __RequestVerificationToken: token
                });

                const resp = await fetch(updateUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body
                });

                if (!resp.ok) {
                    let msg = 'Update failed.';
                    try { const j = await resp.json(); if (j?.error) msg = j.error; } catch {}
                    showStatus(msg, false);
                    if (resp.status === 400 || resp.status === 401) location.reload();
                    return;
                }

                if (resp.status === 200) {
                    const j = await resp.json();
                    nameText.textContent = j.name ?? newName;
                }
                setEditing(false);
                showStatus('Product name updated.', true);
            } catch (err) {
                console.error(err);
                showStatus('Network error updating product.', false);
            }
        });

        (function () {
            var w = document.getElementById('warningMessage');
            var e = document.getElementById('errorMessage');
            if (w) setTimeout(function () { w.style.display = 'none'; }, 5000);
            if (e) setTimeout(function () { e.style.display = 'none'; }, 5000);
        })();

        document.getElementById('deleteForm')?.addEventListener('submit', (e) => {
            if (!confirm('Delete this product?')) e.preventDefault();
        });

        var qtyInput = document.getElementById('qtyInput');
        document.getElementById('qtyMinus')?.addEventListener('click', function () {
            qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1);
        });
        document.getElementById('qtyPlus')?.addEventListener('click', function () {
            qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1;
        });
    })();
</script>

@if (usedIn.Count > 0)
{
<script>
    (function () {
        const oldUpc = @Json.Serialize(productId?.ToString());
        const token = document.querySelector('#afForm input[name="__RequestVerificationToken"]').value;
        const $ = (id) => document.getElementById(id);
        const modal = $('replaceModal'), search = $('replaceSearch'), results = $('replaceResults');
        const boxes = () => [...document.querySelectorAll('.js-replace-recipe')];
        let picked = null, timer = null, seq = 0;

        function refresh() {
            const n = boxes().filter(b => b.checked).length;
            const ok = picked && n > 0;
            const btn = $('replaceConfirm');
            btn.disabled = !ok;
            btn.style.opacity = ok ? '1' : '.5';
            btn.textContent = n > 0 ? `Replace in ${n} recipe${n === 1 ? '' : 's'}` : 'Replace';
            $('replaceToggleAll').textContent = boxes().every(b => b.checked) ? 'Deselect all' : 'Select all';
        }
        function status(text, ok) {
            const s = $('replaceStatus');
            s.textContent = text; s.classList.remove('hidden');
            s.style.color = ok ? '#34C759' : 'var(--ios-red)';
        }
        function setPicked(p) {
            picked = p;
            $('replacePicked').classList.toggle('hidden', !p);
            $('replaceSearchWrap').classList.toggle('hidden', !!p);
            if (p) {
                $('replacePickedName').textContent = p.name;
                $('replacePickedImg').src = 'https://www.kroger.com/product/images/medium/front/' + p.upc;
            }
            refresh();
        }
        function renderResults(items) {
            results.replaceChildren();
            for (const p of items) {
                const row = document.createElement('button');
                row.type = 'button';
                row.className = 'ios-cell gap-3 w-full text-left';
                row.style.minHeight = '56px';
                const img = document.createElement('img');
                img.src = 'https://www.kroger.com/product/images/medium/front/' + p.upc;
                img.alt = ''; img.className = 'h-10 w-10 object-contain flex-shrink-0'; img.loading = 'lazy';
                const box = document.createElement('div');
                box.className = 'min-w-0 flex-1';
                const nm = document.createElement('div');
                nm.className = 'text-[15px] font-medium'; nm.style.color = 'var(--ios-label)'; nm.textContent = p.name;
                const sub = document.createElement('div');
                sub.className = 'text-[13px]'; sub.style.color = 'var(--ios-label-2)';
                sub.textContent = [p.saved ? 'Saved' : null, p.brand, p.size].filter(Boolean).join(' · ');
                box.append(nm, sub);
                row.append(img, box);
                row.addEventListener('click', () => setPicked(p));
                results.append(row);
            }
        }
        async function runSearch(term) {
            const mine = ++seq;
            const get = (url) => fetch(url).then(r => r.ok ? r.json() : []).catch(() => []);
            const [saved, kroger] = await Promise.all([
                get('@Url.Action("SearchDb", "Product")?term=' + encodeURIComponent(term)),
                get('@Url.Action("SearchKroger", "Product")?term=' + encodeURIComponent(term))
            ]);
            if (mine !== seq) return;
            const seen = new Set([oldUpc]);
            const items = [];
            for (const p of (saved || [])) if (!seen.has(p.upc)) { seen.add(p.upc); items.push({ upc: p.upc, name: p.name, saved: true }); }
            for (const p of (kroger || [])) if (!seen.has(p.upc)) { seen.add(p.upc); items.push({ upc: p.upc, name: p.name, brand: p.brand, size: p.size }); }
            renderResults(items);
        }

        $('openReplace').addEventListener('click', () => { modal.classList.remove('hidden'); refresh(); });
        $('replaceCancel').addEventListener('click', () => modal.classList.add('hidden'));
        modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
        $('replaceChange').addEventListener('click', () => { setPicked(null); search.focus(); });
        search.addEventListener('input', () => {
            clearTimeout(timer);
            const term = search.value.trim();
            if (term.length < 2) { seq++; results.replaceChildren(); return; }
            timer = setTimeout(() => runSearch(term), 300);
        });
        $('replaceToggleAll').addEventListener('click', () => {
            const all = boxes().every(b => b.checked);
            boxes().forEach(b => b.checked = !all);
            refresh();
        });
        boxes().forEach(b => b.addEventListener('change', refresh));

        $('replaceConfirm').addEventListener('click', async () => {
            const ids = boxes().filter(b => b.checked).map(b => parseInt(b.value, 10));
            const btn = $('replaceConfirm');
            btn.disabled = true; btn.textContent = 'Replacing…';
            try {
                const resp = await fetch('@Url.Action("ReplaceProductInRecipes", "Product")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ oldUpc, newUpc: picked.upc, recipeIds: ids })
                });
                if (!resp.ok) {
                    let msg = 'Replace failed.';
                    try { const j = await resp.json(); if (j?.error) msg = j.error; } catch {}
                    status(msg, false); refresh(); return;
                }
                // Server is the source of truth: reload so the list reflects what actually changed.
                location.reload();
            } catch (err) {
                console.error(err);
                status('Network error.', false); refresh();
            }
        });
    })();
</script>
}
